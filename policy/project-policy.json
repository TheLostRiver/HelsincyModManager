{
  "requiredFiles": [
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "AGENTS.md",
    "docs/ARCHITECTURE.md",
    "docs/GOVERNANCE.md",
    "docs/LOGGING.md",
    "docs/ROADMAP.md",
    "docs/TESTING.md",
    "docs/release/发布与产物说明.md",
    "docs/release/构建发布与脚本说明.md"
  ],
  "caseSensitiveFiles": [
    "AGENTS.md"
  ],
  "requiredScripts": [
    "scripts/verify.ps1",
    "scripts/verify.sh",
    "scripts/verify-entrypoints.test.mjs",
    "scripts/check-policy.ps1",
    "scripts/check-policy.mjs",
    "scripts/check-file-size.ps1",
    "scripts/check-forbidden-files.ps1",
    "scripts/check-doc-links.ps1",
    "scripts/check-frontend-boundaries.ps1",
    "scripts/check-secrets.ps1",
    "scripts/check-governance-changes.ps1",
    "scripts/check-whitespace.ps1",
    "scripts/install-hooks.ps1"
  ],
  "checkScopes": {
    "preCommit": {
      "excludePathPatterns": [
        ".codex/**"
      ]
    },
    "verify": {
      "excludePathPatterns": []
    }
  },
  "secretScan": {
    "forceIncludePathPatterns": [
      ".codex/**"
    ]
  },
  "fileSize": {
    "blockBytes": 262144,
    "maxLineLength": 1000,
    "maxLineLengthExcludePathPatterns": [
      "docs/**"
    ],
    "review": {
      "rust": 2200,
      "typescript": 2500,
      "javascript": 2500,
      "style": 1800,
      "html": 1800,
      "vue": 1800,
      "svelte": 1800,
      "markdown": 2500,
      "yaml": 700,
      "powershell": 1200,
      "python": 1800,
      "sql": 1200,
      "shell": 1200,
      "toml": 1200,
      "json": 1200,
      "config": 1200
    },
    "block": {
      "rust": 5000,
      "typescript": 5000,
      "javascript": 5000,
      "style": 4000,
      "html": 4000,
      "vue": 4000,
      "svelte": 4000,
      "markdown": 6000,
      "yaml": 2000,
      "powershell": 3000,
      "python": 3000,
      "sql": 3000,
      "shell": 3000,
      "toml": 3000,
      "json": 10000,
      "config": 3000
    },
    "extensions": {
      "rust": [".rs"],
      "typescript": [".ts", ".tsx"],
      "javascript": [".js", ".jsx", ".mjs", ".cjs"],
      "style": [".css", ".scss", ".sass", ".less"],
      "html": [".html", ".htm"],
      "vue": [".vue"],
      "svelte": [".svelte"],
      "markdown": [".md"],
      "yaml": [".yml", ".yaml"],
      "powershell": [".ps1", ".psm1"],
      "python": [".py"],
      "sql": [".sql"],
      "shell": [".sh", ".bash", ".zsh"],
      "toml": [".toml"],
      "json": [".json"],
      "config": [".ini", ".conf", ".config"]
    },
    "allowlist": [
      "pnpm-lock.yaml",
      "Cargo.lock"
    ],
    "excludePathPatterns": [
      ".codex/**"
    ]
  },
  "forbiddenFiles": {
    "extensions": [
      ".zip",
      ".7z",
      ".rar",
      ".sav",
      ".bak"
    ],
    "pathPatterns": [
      ".hmm/**",
      "tmp/**",
      "temp/**",
      "cache/**",
      "backups/**",
      "dist/**",
      "build/**",
      "release-artifacts/**",
      "src-tauri/target/**",
      "target/**"
    ]
  },
  "secretPatterns": [
    {
      "name": "GitHub classic token",
      "regex": "ghp_[A-Za-z0-9_]{30,}"
    },
    {
      "name": "GitHub fine-grained token",
      "regex": "github_pat_[A-Za-z0-9_]{20,}"
    },
    {
      "name": "OpenAI style API key",
      "regex": "sk-[A-Za-z0-9]{20,}"
    },
    {
      "name": "AWS access key",
      "regex": "AKIA[0-9A-Z]{16}"
    },
    {
      "name": "Slack token",
      "regex": "xox[baprs]-[A-Za-z0-9-]{20,}"
    }
  ],
  "governanceFiles": [
    "AGENTS.md",
    "CHANGELOG.md",
    "docs/GOVERNANCE.md",
    "docs/LOGGING.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/TESTING.md",
    "docs/release/**",
    "policy/**",
    "scripts/**",
    ".codex/**",
    ".agents/**",
    ".githooks/**",
    ".github/workflows/**",
    ".github/CODEOWNERS"
  ]
}
